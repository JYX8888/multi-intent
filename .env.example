# 服务监听端口
PORT=3000
# 服务监听地址，生产环境保持 0.0.0.0 以便外部访问
HOST=0.0.0.0
# 模型提供方名称，例如 deepseek
MODEL_PROVIDER=deepseek
# 模型名称，例如 deepseek-v4-flash
MODEL_NAME=deepseek-v4-flash
# 模型 API Key，用于调用大模型
MODEL_API_KEY=
# 调用 /intent-plan 时使用的 Bearer Token
INTENT_API_TOKEN=
# 单个 HTTP 请求的总超时时间，单位毫秒
REQUEST_TIMEOUT_MS=10000
# 单次模型调用的超时时间，单位毫秒
MODEL_TIMEOUT_MS=8000
# 收到 SIGTERM / SIGINT 后的优雅关闭宽限时间，单位毫秒
SHUTDOWN_GRACE_MS=10000
# 同时允许进入模型调用的最大请求数
MAX_MODEL_CONCURRENCY=100
# 进程内最多允许等待的排队请求数
MAX_QUEUE_SIZE=500
# 排队请求等待多久后超时，单位毫秒
QUEUE_TIMEOUT_MS=30000
